{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@arena/shared": ["packages/shared/src"],
      "@arena/shared/*": ["packages/shared/src/*"],
      "@arena/game-core": ["packages/game-core/src"],
      "@arena/game-core/*": ["packages/game-core/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}