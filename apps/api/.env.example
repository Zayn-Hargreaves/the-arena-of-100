# ============================================================
# Arena of 100 - Environment Variables
# ============================================================

# Database
DATABASE_URL="postgresql://arena:arena123@localhost:5432/arena_of_100"
DATABASE_SSL="false"
# When DATABASE_SSL=true, provide the PEM-encoded CA cert to enable verified TLS.
# Without this, TLS uses the system CA store and rejects self-signed certs.
# PG_SSL_CA=""
# Dev/local only: allow self-signed certs (disables verification). NEVER set true in production.
# PG_ALLOW_SELF_SIGNED="false"

# Redis (Standalone mode — default local dev via infrastructure/docker-compose.yml)
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX=""
REDIS_PASSWORD=""
# REDIS_DB="0"

# Redis (Sentinel HA — infrastructure/docker-compose.sentinel.yml)
# When REDIS_SENTINELS is set, Sentinel mode takes precedence over REDIS_URL.
#
# Supported: API on the Compose network (in-network DNS). Host-run API +
# localhost Sentinel ports is NOT supported — Sentinel returns Docker DNS
# names (redis-master / redis-replica-*) the host cannot resolve.
#
# REDIS_SENTINELS="redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379"
# REDIS_SENTINEL_MASTER_NAME="mymaster"
# REDIS_SENTINEL_PASSWORD=""
# REDIS_SENTINEL_ROLE="master"
#
# Host ports when the HA stack is up (smoke / non-HA only):
#   Postgres  localhost:5443
#   Redis     localhost:6390 (master publish), :6391/:6392 (replicas)
#   Sentinel  localhost:26479–26481  (do not use from host API for failover)

# JWT
JWT_SECRET="arena-100-super-secret-key-change-in-production"
JWT_EXPIRES_IN="24h"
REFRESH_EXPIRES_IN=604800

# Server
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Environment
NODE_ENV="development"

# Cookie Settings
CROSS_SITE_COOKIES="false"