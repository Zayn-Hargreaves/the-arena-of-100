# ============================================================
# Arena of 100 - Environment Variables
# ============================================================

# Database
DATABASE_URL="postgresql://arena:arena123@localhost:5432/arena_of_100"
DATABASE_SSL="false"
# When DATABASE_SSL=true, provide the PEM-encoded CA cert to enable verified TLS.
# Without this, TLS uses the system CA store and rejects self-signed certs.
# PG_SSL_CA=""
# Dev/local only: allow self-signed certs (disables verification). NEVER set true in production.
# PG_ALLOW_SELF_SIGNED="false"

# Redis (Standalone mode)
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX=""
REDIS_PASSWORD=""

# Redis (Sentinel HA mode - when REDIS_SENTINELS is set, Sentinel mode takes precedence)
# REDIS_SENTINELS="localhost:26379,localhost:26380,localhost:26381"
# REDIS_SENTINEL_MASTER_NAME="mymaster"
# REDIS_SENTINEL_PASSWORD=""
# REDIS_SENTINEL_ROLE="master"

# JWT
JWT_SECRET="arena-100-super-secret-key-change-in-production"
JWT_EXPIRES_IN="24h"
REFRESH_EXPIRES_IN=604800

# Server
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Environment
NODE_ENV="development"

# Cookie Settings
CROSS_SITE_COOKIES="false"