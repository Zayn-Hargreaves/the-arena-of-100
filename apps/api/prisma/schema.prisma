// ============================================================
// Arena of 100 - Prisma Schema
// PostgreSQL Database Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  ADMIN
}

enum CardVariantKey {
  DEFAULT
  NEON
  GOLD
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionCategory {
  GENERAL
  SCIENCE
  HISTORY
  GEOGRAPHY
  TECHNOLOGY
  SPORTS
  CULTURE
  LOGIC
}

// Users
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  guestId   String?  @unique
  role      Role     @default(GUEST)
  avatar    String   @default("jellyfrog")
  elo       Int      @default(1200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  hostedRooms               Room[]                     @relation("RoomHost")
  roomPlayers               RoomPlayer[]
  matchPlayers              MatchPlayer[]
  answers                   Answer[]
  wonMatches                Match[]                    @relation("MatchWinner")
  dailyAttempts             DailyAttempt[]
  cardVariants              UserCardVariant[]
  pendingCardVariantUnlocks PendingCardVariantUnlock[]
  // PR 3 (Admin Audit): inverse side of EventLog.adminUser. Optional FK
  // (onDelete: SetNull on the EventLog side) so a deleted admin user
  // does not cascade-delete their own audit trail.
  eventLogsAdmin            EventLog[]                 @relation("EventLogAdmin")

  @@index([elo(sort: Desc)], map: "users_elo_idx")
  @@map("users")
}

// Rooms
model Room {
  id             String   @id @default(cuid())
  code           String   @unique
  type           String // PUBLIC | PRIVATE
  status         String // WAITING | COUNTDOWN | IN_GAME | FINISHED
  hostId         String
  maxPlayers     Int      @default(100)
  timeLimit      Int      @default(15)
  category       String   @default("ALL")
  currentMatchId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  host    User         @relation("RoomHost", fields: [hostId], references: [id])
  players RoomPlayer[]
  matches Match[]

  @@map("rooms")
}

// Room Players
model RoomPlayer {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_players")
}

// Matches
model Match {
  id        String    @id @default(cuid())
  roomId    String
  status    String // CREATED | COUNTDOWN | ROUND_ACTIVE | ROUND_EVALUATING | ROUND_RESULT | FINISHED
  winnerId  String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  // Relations
  room      Room          @relation(fields: [roomId], references: [id])
  winner    User?         @relation("MatchWinner", fields: [winnerId], references: [id])
  players   MatchPlayer[]
  rounds    MatchRound[]
  answers   Answer[]
  eventLogs EventLog[]

  // Speeds up the weekly-window filter in /rankings/leaderboard.
  @@index([status, endedAt], map: "matches_status_ended_at_idx")
  @@map("matches")
}

// Match Players
model MatchPlayer {
  id          String  @id @default(cuid())
  matchId     String
  userId      String
  score       Int     @default(0)
  // Phase 3 — count of CARD_RESOLVED events the player triggered.
  // Persisted at finishMatch so the daily leaderboard can aggregate
  // "most cards played this week" without re-reading the event log
  // (which is in-memory/Redis only and gone after the match ends).
  cardsPlayed Int     @default(0)
  // Phase 3 — class assigned for this match (ATTACK / DEFENSE). NULL when
  // the CLASS_ASSIGNED event was never emitted (legacy match or
  // admin-terminated match that bypassed assignment). Read-only on
  // the API surface: derived from the event log at finishMatch.
  classId     String?
  // ELO Rating System
  eloBefore   Int?
  eloAfter    Int?
  eloDelta    Int?

  // Relations
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  // Phase 3 — speeds up the LATERAL aggregate in daily leaderboard +
  // profile stats, both of which filter by mp."userId" and join on
  // mp."matchId". The existing (matchId, userId) UNIQUE index supports
  // matchId-leading lookups but cannot be used efficiently for
  // userId-leading lookups.
  @@index([userId, matchId], map: "match_players_user_id_match_id_idx")
  @@map("match_players")
}

// Match Rounds
model MatchRound {
  id         String    @id @default(cuid())
  matchId    String
  roundNo    Int
  questionId String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  // Relations
  match    Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  answers  Answer[]

  @@unique([matchId, roundNo])
  // Required for composite FK reference from Answer(matchId, roundId) -> (matchId, id)
  @@unique([matchId, id])
  @@map("match_rounds")
}

// Questions
model Question {
  id            String           @id @default(cuid())
  content       String
  options       Json // ["A", "B", "C", "D"]
  correctAnswer String
  difficulty    Difficulty
  category      QuestionCategory
  explanation   String?
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  rounds MatchRound[]
  tags   QuestionTag[]

  @@map("questions")
}

// Answers
model Answer {
  id             String   @id @default(cuid())
  matchId        String
  roundId        String
  userId         String
  answer         String
  isCorrect      Boolean
  responseTimeMs Int
  submittedAt    DateTime @default(now())

  // Relations
  match Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  round MatchRound @relation(fields: [matchId, roundId], references: [matchId, id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  // Speeds up answer_agg in /rankings/leaderboard.
  @@index([matchId, userId], map: "answers_match_id_user_id_idx")
  @@map("answers")
}

// Event Logs (Event Sourcing)
model EventLog {
  id          String   @id @default(cuid())
  // PR 3 (Admin Audit): matchId, roomId, and adminUserId are now all
  // nullable. Match-scoped events (gameplay, snapshots) set matchId;
  // room-scoped events (admin termination, reset) set roomId; admin
  // actions set adminUserId. The triple-null case is a sanity-test
  // artefact only — production code always sets at least one.
  //
  // The previous `seqNo` column + `@@unique([matchId, seqNo])` invariant
  // was dropped: no production code maintained a per-match sequence
  // counter, so the constraint was theoretical only. Ordering for the
  // GET /admin/audit-events query relies on `createdAt` (indexed below)
  // instead. If future event-sourcing work reintroduces seqNo it should
  // also reintroduce the producer that maintains it.
  matchId     String?
  roomId      String?
  adminUserId String?
  eventType   String
  payload     Json
  createdAt   DateTime @default(now())

  // Relations
  // PR 3: onDelete: SetNull on the adminUser FK so deleting an admin
  // user does not cascade-delete their own audit trail. The audit row
  // is preserved with adminUserId = null and the original cuid in the
  // payload JSON for forensic recovery.
  match     Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  adminUser User?  @relation("EventLogAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt], map: "event_logs_admin_user_id_created_at_idx")
  @@index([roomId, createdAt], map: "event_logs_room_id_created_at_idx")
  @@index([eventType, createdAt], map: "event_logs_event_type_created_at_idx")
  @@index([matchId, createdAt], map: "event_logs_match_id_created_at_idx")
  @@map("event_logs")
}

// Tags
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  questions QuestionTag[]

  @@map("tags")
}

// Question Tags (Many-to-Many relation)
model QuestionTag {
  questionId String
  tagId      String
  assignedAt DateTime @default(now())

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@map("question_tags")
}

// Daily Challenge — Phase 1
//
// Append-only question sets. A day may hold several versions: publishing a
// correction inserts version N+1 rather than rewriting N, so the payload a
// player actually answered is never mutated underneath their recorded
// attempt. `DailyAttempt.dailyQuestionId` pins the exact version played,
// which is what makes a stored attempt auditable after the fact.
model DailyQuestion {
  id      String @id @default(cuid())
  dateKey String // "YYYY-MM-DD" — NOT unique: one row per version
  version Int    @default(1)

  questions Json // 5 questions: [{ content, options, correctAnswer, difficulty, category, explanation? }]
  category  QuestionCategory @default(GENERAL)
  active    Boolean          @default(true)

  // Non-null marks the payload as published and therefore immutable. The seed
  // refuses to mutate a published row and appends a new version instead.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attempts DailyAttempt[]

  @@unique([dateKey, version])
  @@index([dateKey, active, version])
  @@map("daily_questions")
}

model DailyAttempt {
  id           String   @id @default(cuid())
  dateKey      String
  userId       String
  answers      Json // [{ answer, isCorrect, responseTimeMs }] — client times are stats-only
  score        Int      @default(0)
  correctCount Int      @default(0)
  streakBefore Int      @default(0)
  streakAfter  Int      @default(0)
  // Server-measured session duration (GET /daily/today -> POST /daily/submit).
  // This, not any client-reported value, is what the speed bonus scores.
  // NULL when the session could not be pinned (anonymous fetch, or the session
  // store was unavailable): the duration is genuinely unknown, so it is stored
  // as such rather than as a 0 that would read like an instantaneous run.
  elapsedMs    Int?
  completedAt  DateTime @default(now())

  // The exact question-set version this attempt was graded against.
  dailyQuestionId String

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyQuestion DailyQuestion @relation(fields: [dailyQuestionId], references: [id], onDelete: Restrict)

  @@unique([dateKey, userId]) // 1 attempt/user/day
  @@index([dateKey, score]) // leaderboard query
  @@index([dailyQuestionId])
  @@map("daily_attempts")
}

// ============================================================
// Phase 3 — Daily streak reward: card variant cosmetic unlock
//
// A row is created when a user's daily streak reaches a multiple of 7
// (Decision 19 in spec §2). The variant is cosmetic only — it swaps the
// card's visual border/glow in the UI; it does NOT change any effect.
//
// `variantKey` is an enum (not a free string) so the set of cosmetic
// variants stays closed and auditable. `cardId` references the canonical
// shared `CardId` union (string), not a Prisma relation — the card
// catalog lives in `@arena/shared` and is intentionally not mirrored as
// a DB table.
//
// The (userId, cardId, variantKey) unique constraint makes the upsert
// idempotent: a replayed streak-unlock attempt cannot create a second
// row for the same triple. The trigger path in `DailyService.submit`
// uses `upsert` (createOnly) so a row that already exists is a no-op.
// ============================================================
model UserCardVariant {
  id         String         @id @default(cuid())
  userId     String
  cardId     String
  variantKey CardVariantKey @default(DEFAULT)
  unlockedAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, variantKey])
  @@index([userId])
  @@map("user_card_variants")
}

// ============================================================
// Phase 3 — durable pending-grant intent
//
// A row is inserted (in the same transaction as `dailyAttempt.create`)
// when the cosmetic-unlock `userCardVariant.upsert` inside the submit
// transaction fails. The next submit — regardless of
// `shouldAttemptUnlock` — drains pending rows for the user, attempts
// the idempotent upsert, and marks the row `processedAt = now()`.
//
// Why a separate table:
//   - The unique constraint on `user_card_variants` enforces
//     idempotency of the upsert WHEN IT FIRES, but is NOT a "pending
//     grant" by itself — a transient DB error inside the submit
//     transaction does not write a `user_card_variants` row, so
//     there is nothing to replay against.
//   - The in-process retry counter used in the original 2026-08-13
//     implementation could not survive a process restart, and relied
//     on the user crossing the same streak boundary again — a streak
//     reset zeroes `streakAfter`, so a user who tripped the unlock
//     once and then missed a day would never get the row.
//   - The drain runs on EVERY submit (independently of
//     `shouldAttemptUnlock`) so a streak reset does not strand the
//     row.
//
// `@@unique([userId, dateKey, streakAfter])` makes the pending-row
// insert idempotent within a single day's attempt: a retried submit
// at the same unlock boundary hits P2002 and is swallowed as a
// no-op, but a later submit on a DIFFERENT `dateKey` crossing the
// same `streakAfter` after the previous grant was processed can
// create a fresh pending row. `processedAt` is nullable so the
// drainer can find unprocessed rows with `WHERE processedAt IS NULL`.
//
// Partial index note: a `WHERE processedAt IS NULL` partial index
// on `userId` is maintained manually by migration
// `20260812130000_phase3_pending_card_variant_unlock/migration.sql`
// to match the drainer's predicate. Prisma cannot declare partial
// indexes inline, so the model intentionally does NOT carry an
// `@@index([userId])` — it would create a non-partial index that
// is redundant with the partial one below.
// ============================================================
model PendingCardVariantUnlock {
  id          String    @id @default(cuid())
  userId      String
  dateKey     String
  streakAfter Int
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey, streakAfter])
  @@map("pending_card_variant_unlocks")
}
