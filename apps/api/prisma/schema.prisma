// ============================================================
// Arena of 100 - Prisma Schema
// PostgreSQL Database Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  ADMIN
}

// Users
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  guestId   String?  @unique
  role      Role     @default(GUEST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  hostedRooms  Room[]          @relation("RoomHost")
  roomPlayers  RoomPlayer[]
  matchPlayers MatchPlayer[]
  answers      Answer[]
  wonMatches   Match[]         @relation("MatchWinner")

  @@map("users")
}

// Rooms
model Room {
  id            String   @id @default(cuid())
  code          String   @unique
  type          String   // PUBLIC | PRIVATE
  status        String   // WAITING | COUNTDOWN | IN_GAME | FINISHED
  hostId        String
  maxPlayers    Int      @default(100)
  currentMatchId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  host    User         @relation("RoomHost", fields: [hostId], references: [id])
  players RoomPlayer[]
  matches Match[]

  @@map("rooms")
}

// Room Players
model RoomPlayer {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_players")
}

// Matches
model Match {
  id        String    @id @default(cuid())
  roomId    String
  status    String    // CREATED | COUNTDOWN | ROUND_ACTIVE | ROUND_EVALUATING | ROUND_RESULT | FINISHED
  winnerId  String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  // Relations
  room    Room          @relation(fields: [roomId], references: [id])
  winner  User?         @relation("MatchWinner", fields: [winnerId], references: [id])
  players MatchPlayer[]
  rounds  MatchRound[]
  answers Answer[]

  @@map("matches")
}

// Match Players
model MatchPlayer {
  id      String @id @default(cuid())
  matchId String
  userId  String
  score   Int    @default(0)

  // Relations
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@map("match_players")
}

// Match Rounds
model MatchRound {
  id         String   @id @default(cuid())
  matchId    String
  roundNo    Int
  questionId String
  startedAt  DateTime @default(now())
  endedAt    DateTime?

  // Relations
  match   Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  answers Answer[]

  @@unique([matchId, roundNo])
  @@map("match_rounds")
}

// Questions
model Question {
  id            String   @id @default(cuid())
  content       String
  options       Json     // ["A", "B", "C", "D"]
  correctAnswer String
  difficulty    String   // EASY | MEDIUM | HARD
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Relations
  rounds MatchRound[]

  @@map("questions")
}

// Answers
model Answer {
  id             String   @id @default(cuid())
  matchId        String
  roundId        String
  userId         String
  answer         String
  isCorrect      Boolean
  responseTimeMs Int
  submittedAt    DateTime @default(now())

  // Relations
  match Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  round MatchRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@map("answers")
}

// Event Logs (Event Sourcing)
model EventLog {
  id         String   @id @default(cuid())
  matchId    String
  seqNo      Int
  eventType  String
  payload    Json
  createdAt  DateTime @default(now())

  @@unique([matchId, seqNo])
  @@index([matchId, seqNo])
  @@map("event_logs")
}