// ============================================================
// Arena of 100 - Prisma Schema
// PostgreSQL Database Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionCategory {
  GENERAL
  SCIENCE
  HISTORY
  GEOGRAPHY
  TECHNOLOGY
  SPORTS
  CULTURE
  LOGIC
}

// Users
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  guestId   String?  @unique
  role      Role     @default(GUEST)
  avatar    String   @default("jellyfrog")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  hostedRooms    Room[]          @relation("RoomHost")
  roomPlayers    RoomPlayer[]
  matchPlayers   MatchPlayer[]
  answers        Answer[]
  wonMatches     Match[]         @relation("MatchWinner")
  // PR 3 (Admin Audit): inverse side of EventLog.adminUser. Optional FK
  // (onDelete: SetNull on the EventLog side) so a deleted admin user
  // does not cascade-delete their own audit trail.
  eventLogsAdmin EventLog[]      @relation("EventLogAdmin")

  @@map("users")
}

// Rooms
model Room {
  id            String   @id @default(cuid())
  code          String   @unique
  type          String   // PUBLIC | PRIVATE
  status        String   // WAITING | COUNTDOWN | IN_GAME | FINISHED
  hostId        String
  maxPlayers    Int      @default(100)
  timeLimit     Int      @default(15)
  category      String   @default("ALL")
  currentMatchId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  host    User         @relation("RoomHost", fields: [hostId], references: [id])
  players RoomPlayer[]
  matches Match[]

  @@map("rooms")
}

// Room Players
model RoomPlayer {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_players")
}

// Matches
model Match {
  id        String    @id @default(cuid())
  roomId    String
  status    String    // CREATED | COUNTDOWN | ROUND_ACTIVE | ROUND_EVALUATING | ROUND_RESULT | FINISHED
  winnerId  String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  // Relations
  room      Room          @relation(fields: [roomId], references: [id])
  winner    User?         @relation("MatchWinner", fields: [winnerId], references: [id])
  players   MatchPlayer[]
  rounds    MatchRound[]
  answers   Answer[]
  eventLogs EventLog[]

  // Speeds up the weekly-window filter in /rankings/leaderboard.
  @@index([status, endedAt], map: "matches_status_ended_at_idx")
  @@map("matches")
}

// Match Players
model MatchPlayer {
  id      String @id @default(cuid())
  matchId String
  userId  String
  score   Int    @default(0)

  // Relations
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@map("match_players")
}

// Match Rounds
model MatchRound {
  id         String   @id @default(cuid())
  matchId    String
  roundNo    Int
  questionId String
  startedAt  DateTime @default(now())
  endedAt    DateTime?

  // Relations
  match   Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  answers Answer[]

  @@unique([matchId, roundNo])
  // Required for composite FK reference from Answer(matchId, roundId) -> (matchId, id)
  @@unique([matchId, id])
  @@map("match_rounds")
}

// Questions
model Question {
  id            String   @id @default(cuid())
  content       String
  options       Json     // ["A", "B", "C", "D"]
  correctAnswer String
  difficulty    Difficulty
  category      QuestionCategory
  explanation   String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  rounds MatchRound[]
  tags   QuestionTag[]

  @@map("questions")
}

// Answers
model Answer {
  id             String   @id @default(cuid())
  matchId        String
  roundId        String
  userId         String
  answer         String
  isCorrect      Boolean
  responseTimeMs Int
  submittedAt    DateTime @default(now())

  // Relations
  match Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  round MatchRound @relation(fields: [matchId, roundId], references: [matchId, id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  // Speeds up answer_agg in /rankings/leaderboard.
  @@index([matchId, userId], map: "answers_match_id_user_id_idx")
  @@map("answers")
}

// Event Logs (Event Sourcing)
model EventLog {
  id         String   @id @default(cuid())
  // PR 3 (Admin Audit): matchId, roomId, and adminUserId are now all
  // nullable. Match-scoped events (gameplay, snapshots) set matchId;
  // room-scoped events (admin termination, reset) set roomId; admin
  // actions set adminUserId. The triple-null case is a sanity-test
  // artefact only — production code always sets at least one.
  //
  // The previous `seqNo` column + `@@unique([matchId, seqNo])` invariant
  // was dropped: no production code maintained a per-match sequence
  // counter, so the constraint was theoretical only. Ordering for the
  // GET /admin/audit-events query relies on `createdAt` (indexed below)
  // instead. If future event-sourcing work reintroduces seqNo it should
  // also reintroduce the producer that maintains it.
  matchId    String?
  roomId     String?
  adminUserId String?
  eventType  String
  payload    Json
  createdAt  DateTime @default(now())

  // Relations
  // PR 3: onDelete: SetNull on the adminUser FK so deleting an admin
  // user does not cascade-delete their own audit trail. The audit row
  // is preserved with adminUserId = null and the original cuid in the
  // payload JSON for forensic recovery.
  match      Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  adminUser  User?    @relation("EventLogAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt], map: "event_logs_admin_user_id_created_at_idx")
  @@index([roomId, createdAt], map: "event_logs_room_id_created_at_idx")
  @@index([eventType, createdAt], map: "event_logs_event_type_created_at_idx")
  @@index([matchId, createdAt], map: "event_logs_match_id_created_at_idx")
  @@map("event_logs")
}

// Tags
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  questions QuestionTag[]

  @@map("tags")
}

// Question Tags (Many-to-Many relation)
model QuestionTag {
  questionId String
  tagId      String
  assignedAt DateTime @default(now())

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@map("question_tags")
}
