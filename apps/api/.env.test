# ============================================================
# Arena of 100 - E2E Test Environment Variables
# Local defaults target the docker-compose.test.yml Postgres
# on :5434 and Redis on :6379 (DB index 1).
#
# In CI, override DATABASE_URL / REDIS_URL via the workflow
# env block (do NOT hardcode them in the npm scripts).
# ============================================================

DATABASE_URL="postgresql://arena_test:arena_test@localhost:5434/arena_test"
REDIS_URL="redis://localhost:6379/1"
NODE_ENV="test"

# JWT — the test factory's default matches this. Override in CI
# if your secrets use a different key.
JWT_SECRET="arena-100-secret-key"
