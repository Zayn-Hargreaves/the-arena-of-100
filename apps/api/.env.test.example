# ============================================================
# Arena of 100 - E2E Test Environment Variables (example)
# Copy to `.env.test` and adjust for your local Docker ports.
# Defaults target docker-compose.test.yml on :5434 / :6379.
#
# In CI, override DATABASE_URL / REDIS_URL via the workflow env
# block (the npm script `test:e2e` reads them from `.env.test`
# via dotenv-cli when running locally).
# ============================================================

DATABASE_URL="postgresql://arena_test:arena_test@localhost:5434/arena_test"
REDIS_URL="redis://localhost:6379/1"
NODE_ENV="test"
JWT_SECRET="arena-100-secret-key"
