{
  "name": "@arena/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix --cache",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:dev": "cross-env SEED_ENV=dev tsx prisma/seed.ts",
    "prisma:seed:test": "cross-env SEED_ENV=test tsx prisma/seed.ts",
    "prisma:seed:demo": "tsx --tsconfig prisma/tsconfig.json prisma/seed-demo.ts",
    "prisma:seed:demo:reset": "cross-env DEMO_RESET=true tsx --tsconfig prisma/tsconfig.json prisma/seed-demo.ts",
    "prisma:seed:demo:unsafe": "cross-env DEMO_ALLOW_DEV_DB=true tsx --tsconfig prisma/tsconfig.json prisma/seed-demo.ts",
    "prisma:seed:demo:reset:unsafe": "cross-env DEMO_ALLOW_DEV_DB=true DEMO_RESET=true tsx --tsconfig prisma/tsconfig.json prisma/seed-demo.ts",
    "test:e2e": "cross-env NODE_ENV=test bash -ac 'source .env.test && vitest run --config test/vitest-e2e.config.ts'",
    "test:e2e:watch": "cross-env NODE_ENV=test bash -ac 'source .env.test && vitest --config test/vitest-e2e.config.ts'"
  },
  "dependencies": {
    "@arena/game-core": "workspace:*",
    "@arena/shared": "workspace:*",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^9.1.3",
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-fastify": "^11.1.21",
    "@nestjs/platform-socket.io": "^11.1.21",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.21",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "fast-deep-equal": "^3.1.3",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "nanoid": "^5.0.9",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.21",
    "@swc/core": "^1.15.40",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.8",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.17.0",
    "fastify": "^5.0.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^2.1.8"
  }
}
