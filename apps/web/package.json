{
  "name": "@arena/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "audit:a11y": "python3 ../../.opencode/skills/frontend-design/scripts/accessibility_checker.py src",
    "audit:ux": "python3 ../../.opencode/skills/frontend-design/scripts/ux_audit.py src",
    "build": "next build",
    "dev": "NEXT_FONT_GOOGLE_MOCK=1 next dev --port 3000",
    "start": "next start",
    "lint": "next lint --cache-location .eslintcache",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "pnpm build && pnpm typecheck && pnpm lint"
  },
  "dependencies": {
    "@arena/shared": "workspace:*",
    "zod": "^3.24.1",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-toast": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.1.7",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-virtual": "^3.13.12",
    "axios": "^1.17.0",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.1.4",
    "next-intl": "^4.13.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
